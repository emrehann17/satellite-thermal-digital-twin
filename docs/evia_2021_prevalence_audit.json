  "contract_difference": "AOI geometry only",
  "registry_source": "core/regions.py",
  "shared_contract": {
    "note": "Every field below is BIT-IDENTICAL between evia_2021 and evia_2021_extended; only region_key/AOI geometry, display_name and output_namespace differ.",
    "predictor_start_date": "2021-06-05",
    "predictor_end_date": "2021-08-02",
    "label_start_date": "2021-08-03",
    "label_end_date": "2021-09-30",
    "baseline_years": [
      2017,
      2018,
      2019,
      2020
    ],
    "role": "mediterranean_transfer_wildfire",
    "country": "Greece",
    "label_source": "MCD64A1 in-window BurnDate; FIRMS is never used as a target",
    "exclude_pre_label_burns": true,
    "pre_label_burn_window": [
      "2021-06-05",
      "2021-08-02"
    ],
    "grid": {
      "sample_unit": "reconstructed ~500 m MCD64A1 cell",
      "block_size_pixels": 17,
      "never_30m_pixels": true
    },
    "baseline_features": [
      "ndvi_mean",
      "elevation_mean",
      "slope_mean",
      "landcover_dominant"
    ],
    "thermal_features_added": [
      "lst_anomaly_mean",
      "current_lst_mean",
      "current_tvdi_mean",
      "tvdi_difference_mean",
      "downscaled_lst_mean",
      "fused_lst_mean"
    ],
    "model": {
      "name": "random_forest",
      "cross_validation": "StratifiedGroupKFold over 500 m spatial blocks",
      "n_splits": 5,
      "random_row_wise_split": false
    },
    "exclusion_rules": [
      "valid_for_modeling == False cells are dropped from every model population",
      "cells burned before label_start are excluded from the analysis universe (exclude_pre_label_burns=True), never counted as unburned negatives",
      "cropland-dominant cells are excluded from the burnable_tree_shrub_grass mask"
    ]
  },
  "population_scope_note": {
    "step8b_module_primary": "all_valid",
    "downstream_primary": "burnable_tree_shrub_grass",
    "interpretation": "Both are active scope-specific definitions; downstream products explicitly reselect burnable_tree_shrub_grass.",
    "step8b_module_primary_source": "core/config.py:STEP8B_PRIMARY_POPULATION",
    "downstream_primary_source": "src/step9a_audit_cross_region_inputs.py:PRIMARY_POPULATIONS[0]",
    "downstream_reselection_site": "src/multi_aoi_transfer_synthesis/schema_adapters.py:adapt_step8_within_region reads population_metrics['burnable_tree_shrub_grass'] and does not consult the step8b JSON's own 'primary_population' field"
  },
