{
  "schema_version": "evia.variant_prevalence_audit.v1",
  "description": "Frozen, machine-readable comparison of the two North Evia AOI variants. Records that the ONLY contract difference is AOI geometry, and reports four DISTINCT prevalence definitions per variant so that quoting one number without its definition can be detected. Read-only: derived entirely from already-frozen Step8A/Step8B artifacts; no model, transfer, bootstrap or export was run to produce it, and no legacy output was deleted or overwritten.",
  "canonical_variant": "evia_2021_extended",
  "legacy_variant": "evia_2021",
  "legacy_status": "legacy_superseded",
