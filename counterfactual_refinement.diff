+    if cur == diff == z == "supported_reduction":
+        return "supported_reduction"
+    if all(s == "supported_increase" for s in trio):
+        return "supported_increase"
+    if all(s == "insufficient_evidence" for s in trio):
+        return "insufficient_evidence"
+    return "uncertain"
